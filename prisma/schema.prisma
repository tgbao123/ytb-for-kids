generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id          String   @id @default(uuid())
  title       String
  videoUrl    String
  thumbnail   String
  views       String
  likes       Int      @default(0)
  dislikes    Int      @default(0)
  comments    Int      @default(0)
  createdAt   DateTime @default(now())
  authorName  String
  authorAvatar String
}

model Setting {
  key   String @id
  value String
}
